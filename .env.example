# =============================================================================
# OnlyFans Boudoir Pipeline — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commit o arquivo .env no repositório
# =============================================================================

# -----------------------------------------------------------------------------
# API OnlyFans
# -----------------------------------------------------------------------------
OF_API_KEY=sua_chave_api_aqui
OF_API_SECRET=seu_api_secret_aqui
OF_BASE_URL=https://onlyfans.com/api/v1

# -----------------------------------------------------------------------------
# Modelo de Linguagem (LLM) para o Agente Interativo
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai              # openai | anthropic | local
LLM_API_KEY=sua_chave_llm_aqui
LLM_MODEL=gpt-4o                 # gpt-4o | claude-3-5-sonnet | etc.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Banco de Dados
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///pipeline.db
# Para PostgreSQL: postgresql://usuario:senha@localhost:5432/pipeline_db

# -----------------------------------------------------------------------------
# Storage de Mídia
# -----------------------------------------------------------------------------
MEDIA_STORAGE=local              # local | s3 | gcs
MEDIA_PATH=./media

# S3 (se MEDIA_STORAGE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Google Cloud Storage (se MEDIA_STORAGE=gcs)
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# -----------------------------------------------------------------------------
# Notificações (Opcional)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Pipeline
# -----------------------------------------------------------------------------
PIPELINE_ENV=development         # development | production
PIPELINE_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
PIPELINE_TIMEZONE=America/Sao_Paulo
PIPELINE_DRY_RUN=false           # true = não publica de verdade (teste)

# -----------------------------------------------------------------------------
# Segurança
# -----------------------------------------------------------------------------
SECRET_KEY=gere-uma-chave-aleatoria-forte-aqui
ENCRYPTION_KEY=chave-de-criptografia-para-credenciais
